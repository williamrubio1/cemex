# ─────────────────────────────────────────────────────────────
#  Campañas de WhatsApp CETEX — variables de entorno (PLANTILLA)
#  Copia este archivo a .env y completa los valores reales.
#  .env NUNCA se sube a git (está en .gitignore).
# ─────────────────────────────────────────────────────────────

# ── WhatsApp Cloud API (portafolio de CETEX, app "Notifica Cetex") ──
# Token PERMANENTE del usuario del sistema (SECRETO).
# Permisos: whatsapp_business_messaging, whatsapp_business_management
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
WABA_ID=
GRAPH_VERSION=v26.0
# La plantilla y el idioma salen de la tabla `campanas`; estos son el respaldo.
TEMPLATE_NAME=cetex_seminario_cierre_2026
TEMPLATE_LANG=es_CO
# Variable del cuerpo: vacío -> {{1}} posicional · "nombre" -> {{nombre}} · "-" -> sin variables
TEMPLATE_PARAM_NAME=
# Saludo cuando el contacto no tiene nombre: "Hola estimado(a), le saluda CETEX."
TEMPLATE_NOMBRE_DEFECTO=estimado(a)
# Solo si el botón "Quiero participar" usa URL DINÁMICA https://<dominio>/r/{{1}}:
# índice del botón en la plantilla (0, 1 o 2). Vacío = URL estática.
TEMPLATE_URL_BOTON_INDEX=

# ── Webhook ─────────────────────────────────────────────────
# Cadena que tú inventas; debe coincidir con la que registres en Meta.
VERIFY_TOKEN=
PORT=3000
# App Secret de Meta (App → Configuración → Básica). Recomendado: valida la firma de cada POST.
APP_SECRET=
# Dominio público de la plataforma, sin "/" final. Activa la medición de clics vía /r/<token>.
PUBLIC_URL=

# ── Contactos ───────────────────────────────────────────────
# Celulares que NUNCA se contactan, separados por coma (línea de ventas de CETEX, pruebas…).
EXCLUIR_CELULARES=3142511033

# ── Identidad en paneles e informes ─────────────────────────
CLIENTE_NOMBRE=CETEX
CLIENTE_WEB=cetex.com.co
OP_NOMBRE=Soluctia S.A.S.
OP_WEB=soluctiasas.com
OP_DIRECCION=
OP_CIUDAD=
OP_CORREO=
OP_TELEFONO=
OP_NIT=

# ── Vistas internas /respuestas y /analisis ─────────────────
# Crear usuarios con:  npm run crear-usuario -- <usuario> <contraseña>
# Secreto para firmar la cookie de sesión (cadena larga y aleatoria).
SESSION_SECRET=

# ── Base de datos MySQL (Hostinger, base NUEVA de CETEX) ────
# Desde tu PC: host remoto de Hostinger + "Remote MySQL" con tu IP.
# En Hostinger (la app Node): DB_HOST=127.0.0.1
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
